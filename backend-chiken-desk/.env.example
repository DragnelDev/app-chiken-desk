PORT=3000
# Misma zona horaria que PostgreSQL (los timestamps no guardan zona)
TZ=America/La_Paz

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=chikendesk

# Obligatorio. Genera uno largo y aleatorio: openssl rand -base64 48
JWT_TOKEN=cambia_esta_clave_larga_y_secreta
JWT_EXPIRES_IN=8h

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:4200

# Carpeta (relativa a la raíz del backend) donde se guardan las imágenes subidas
UPLOADS_DIR=uploads

# Pagos QR
QR_EXPIRA_MINUTOS=10
# Secreto que debe enviar el banco/pasarela en el header x-webhook-secret
QR_WEBHOOK_SECRET=cambia_este_secreto_del_webhook
# Permite que un ADMIN confirme un QR a mano (sandbox / contingencia). En producción: false
QR_CONFIRMACION_MANUAL=true
